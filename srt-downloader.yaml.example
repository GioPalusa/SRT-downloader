# Example configuration file for SRT Downloader

# Folder to scan. Defaults to the current directory when omitted.
path: .

# Languages are tried in order. English is appended automatically if not present.
languages:
  - sv
  - en

# Optional preferred provider order. Public fallback providers are appended unless disabled.
selected_providers:
  - opensubtitlescom

# Optional provider credentials.
providers:
  opensubtitlescom:
    username: your_username
    password: your_password
  addic7ed:
    username: your_username
    password: your_password

# Restrict the run to only selected and credentialed providers.
only_selected_providers: false

# Slower, but shows provider-by-provider progress.
detailed_progress: false

# Enable debug logging.
verbose: false

# Subtitle file encoding.
encoding: utf-8

# Days before a previously not-found video is searched again.
# (Resume is always on; pass --clean on the command line to reset progress.)
recheck_after_days: 14

# Number of videos to process in parallel (1 = sequential with detailed progress).
jobs: 4

# Minimum delay (seconds) between searches across workers, to stay polite.
min_request_interval: 0

# Auto-correct subtitle timing with ffsubsync after download (needs ffsubsync + ffmpeg).
sync: false